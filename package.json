{
  "name": "my-freelance-project",
  "version": "1.0.0",
  "scripts": {
    "start": "parcel serve src/index.html",
    "sass": "sass src/css/main.scss src/css/styles.css --watch",
    "dev": "npm-run-all --parallel start sass",
    "build": "parcel build src/index.html --dist-dir dist --public-url ./",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "gh-pages": "^3.2.3",
    "live-server": "^1.2.1",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.12.0",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "sass": "^1.32.8"
  },
  "staticFiles": {
    "staticPath": "src/videos",
    "outputPath": "videos"
  }
}
